# ============================================================
# SK STORE — secrets (Streamlit Cloud → App → Settings → Secrets)
# Ye file GitHub par NAHI jayegi. ".example" wali copy rakho,
# asal values sirf Streamlit Cloud ke Secrets me paste karo.
# ============================================================

# Supabase → Project Settings → API
SUPABASE_URL = "https://xyzcompany.supabase.co"
SUPABASE_ANON_KEY = "eyJhbGciOi..."
SUPABASE_SERVICE_KEY = "eyJhbGciOi..."   # service_role key (uploads ke liye)

# Admin portal login (/admin) — apni marzi ka user/pass rakho
ADMIN_USER = "admin"
ADMIN_PASS = "apna-mazboot-password-yahan"

# Store
STORE_NAME = "SK Store"
APP_URL = "https://skstore.streamlit.app"   # deploy ke baad asal URL

# Gmail order emails (App Password guide README me hai)
GMAIL_USER = "youremail@gmail.com"
GMAIL_APP_PASSWORD = "xxxx xxxx xxxx xxxx"
ADMIN_NOTIFY_EMAIL = "youremail@gmail.com"  # new-order alerts yahan ayenge
